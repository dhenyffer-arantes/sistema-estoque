PORT=3000
NODE_ENV=development

# Configurações do Banco de Dados PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=estoque_db

# JWT & Segurança (Semana 3)
JWT_SECRET=sua_chave_secreta_super_segura_aqui
JWT_EXPIRES_IN=1d

# Configurações do Servidor de E-mail para Recuperação de Senha (Semana 3)
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=seu_usuario
MAIL_PASS=sua_senha
MAIL_FROM=nao-responda@estoque.com